{
  "evaluation": {
    "source": {
      "name": "emergency_visits",
      "display": "emergency_visits",
      "aggregation": "AGGREGATION_UNSPECIFIED"
    },
    "comparison_operator": "GREATER_THAN",
    "threshold": {
      "value": {
        "double_value": 10.0
      }
    },
    "notification": {}
  },
  "schedule": {
    "quartz_cron_schedule": "31 11 * * * ?",
    "timezone_id": "Asia/Calcutta"
  },
  "query_lines": [
    "SELECT",
    "    department,",
    "    visit_date,",
    "    COUNT(*) AS emergency_visits",
    "",
    "FROM silver.patient_visits",
    "",
    "WHERE visit_type = 'Emergency'",
    "",
    "GROUP BY department, visit_date",
    "",
    "HAVING COUNT(*) > 10;"
  ]
}
